rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{file} {
      allow write: if request.auth != null
                   && request.resource.size < 250 * 1024 * 1024;
      allow read: if false;
    }
    match /inbox/{file} {
      allow read: if true;
      allow write: if false;
    }
  }
}
